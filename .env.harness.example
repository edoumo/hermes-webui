# Hermes Harness UI (experimental, default off)
HERMES_WEBUI_HARNESS_UI=1

# Dedicated Harness frontend/BFF listener. Loopback is the safe default.
HERMES_HARNESS_HOST=127.0.0.1
HERMES_HARNESS_PORT=8790

# Optional LAN access. A non-loopback HERMES_HARNESS_HOST is rejected unless
# BOTH remote binding is explicitly enabled and password authentication is set.
# Prefer a specific LAN address over 0.0.0.0 and never expose Harness directly
# to the public Internet.
# HERMES_HARNESS_HOST=192.168.1.187
# HERMES_HARNESS_ALLOW_REMOTE=1
# HERMES_WEBUI_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Keep Harness authentication state separate from a concurrently running
# legacy WebUI. The entry point defaults to ~/.hermes/webui-harness.
# HERMES_HARNESS_STATE_DIR=/home/USER/.hermes/webui-harness

# Canonical Hermes API stays loopback-only even when the browser-facing
# Harness listener is explicitly made reachable on the LAN.
HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642

# Required by the BFF. Never expose this value to browser JavaScript.
HERMES_WEBUI_GATEWAY_API_KEY=REPLACE_WITH_LAB_API_KEY

# On loopback, the normal WebUI auth rules apply if no explicit password is set.
# For any non-loopback Harness bind, HERMES_WEBUI_PASSWORD is mandatory.
